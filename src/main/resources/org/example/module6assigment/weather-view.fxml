<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            stylesheets="@weather.css" styleClass="app" prefWidth="760" prefHeight="680">

    <top>
        <VBox styleClass="header" spacing="4">
            <Label text="Weather Data Analyzer" styleClass="title"/>
            <Label fx:id="statusLabel" text="No file loaded" styleClass="status"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="12">
            <padding>
                <Insets top="14" right="16" bottom="16" left="16"/>
            </padding>

            <!-- Step 1: pick data and settings -->
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="toolbar">
                <Button fx:id="loadButton" text="Load CSV…"/>
                <Separator orientation="VERTICAL"/>
                <Label text="Month"/>
                <ComboBox fx:id="monthBox" prefWidth="110"/>
                <Label text="Hot-day threshold (°C)"/>
                <TextField fx:id="thresholdField" text="30" prefWidth="60"/>
                <Button fx:id="analyzeButton" text="Analyze" styleClass="primary"/>
            </HBox>

            <!-- Step 2: the raw data -->
            <Label text="Data" styleClass="section"/>
            <TableView fx:id="table" VBox.vgrow="ALWAYS"/>

            <!-- Step 3: the answers -->
            <Label text="Results" styleClass="section"/>
            <TextArea fx:id="outputArea" editable="false" prefRowCount="13" styleClass="report"/>
        </VBox>
    </center>
</BorderPane>